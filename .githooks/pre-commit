#!/usr/bin/env sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if command -v uvx >/dev/null 2>&1; then
  exec uvx --from pre-commit==4.6.0 pre-commit run \
    --config .pre-commit-config.yaml --hook-stage pre-commit
fi

if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --config .pre-commit-config.yaml --hook-stage pre-commit
fi

echo "pre-commit requires uvx or pre-commit. Run tools/setup_git_hooks first." >&2
exit 1
