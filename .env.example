# Compose local development defaults

SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://postgres:5432/cvmobile
DB_USERNAME=postgres
DB_PASSWORD=change_me_local_db_password
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
POSTGRES_PORT=5436

JWT_SECRET=dev-compose-only-A7zQ9mK2xR8pL4vN6sT1wY5cD3fH0jU7eB9gM2qX8kP4rV6n
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:8082
SERVER_PORT=8082
SHOW_SQL=false

DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_FALLBACK_ENABLED=true

UPLOAD_DIR=/app/uploads
FIREBASE_NOTIFICATIONS_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=disabled
STALE_CV_DAYS=30
NOTIFICATION_REMINDER_CRON=0 0 9 * * *

MANAGEMENT_PROMETHEUS_ALLOWED_IP_RANGES=127.0.0.1/32,::1/128

# Generer avec : openssl rand -base64 32
# PowerShell : [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Ne jamais committer sa valeur.
PUBLIC_LINK_ENCRYPTION_KEY=
PUBLIC_MEDIA_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# Mail (Gmail : mot de passe d'application, pas le mot de passe du compte)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@moncv.app
FRONTEND_URL=http://localhost:8080
