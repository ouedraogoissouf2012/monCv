# Copy to .env.production, fill every required value, then restrict access.
# Linux/macOS: chmod 600 .env.production
# Never commit .env.production or print its rendered Compose configuration.

# Full 40-character lowercase Git SHA already published to GHCR.
TAG=""

# Only the host reverse proxy should access this loopback port.
WEB_PORT=8080

# PostgreSQL credentials shared by the database and backend containers.
DB_USERNAME=""
DB_PASSWORD=""

# OAuth client identifier required by the production backend.
GOOGLE_CLIENT_ID=""

# Add the required JWT_SECRET after: openssl rand -base64 64
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Comma-separated HTTPS origins. Wildcards and localhost are forbidden in prod.
ALLOWED_ORIGINS=""

# AI provider configuration.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Generate PUBLIC_LINK_ENCRYPTION_KEY with: openssl rand -base64 32
PUBLIC_LINK_ENCRYPTION_KEY=""
PUBLIC_MEDIA_ALLOWED_ORIGINS=""

# Optional error monitoring endpoint. Leave empty to disable.
SENTRY_DSN=""
